rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global site settings document
    // Disallow arbitrary client-side writes. Only authenticated admin or verified server requests with valid server secret can write.
    match /settings/siteConfig {
      allow read: if true;
      allow write: if request.auth != null || (
        request.resource.data._serverSecret != null &&
        request.resource.data._serverSecret is string &&
        request.resource.data._serverSecret == "fss_C2NeQLY4aNj3odkuHIcQdyZs"
      );
    }

    // Default catch-all
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
