rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global site settings document
    // Disallow arbitrary client-side writes. Only authenticated admin or verified server requests with internal server authorization token can write.
    match /settings/siteConfig {
      allow read: if true;
      allow write: if request.auth != null || (
        request.resource.data._serverSecret != null &&
        request.resource.data._serverSecret is string &&
        (request.resource.data._serverSecret == "amz_srv_sec_f98c21a4" || request.resource.data._serverSecret == "yy661003")
      );
    }

    // Default catch-all
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
